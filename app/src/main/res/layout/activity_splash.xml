<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0A12">
    <View android:layout_width="220dp" android:layout_height="220dp"
        android:layout_gravity="center" android:background="@drawable/bg_splash_blob"
        android:alpha="0.9"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AETHER" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold"
            android:letterSpacing="0.12"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MUSIC" android:textColor="#5EEAD4" android:textSize="16sp"
            android:letterSpacing="0.3" android:layout_marginTop="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="liquid · local · yours" android:textColor="#66FFFFFF" android:textSize="12sp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</FrameLayout>
