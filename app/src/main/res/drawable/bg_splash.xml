<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0F"/>
        </shape>
    </item>
    <item android:gravity="center" android:width="200dp" android:height="200dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="100dp"
                android:startColor="#33FFFFFF" android:endColor="#000B0B0F"/>
        </shape>
    </item>
</layer-list>
